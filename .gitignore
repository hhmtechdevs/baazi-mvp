# Dependencies and build output — Vercel installs and builds these itself.
node_modules/
dist/
*.tsbuildinfo

# Local configuration. The Supabase anon key is designed to ship in the client bundle, so it is not
# a secret in the dangerous sense — but it still belongs in the deploy's environment settings rather
# than in the repository.
.env
.env.local
.env.*.local

.DS_Store

# Claude Code's local working files. Background tasks create git worktrees under .claude/worktrees
# — each one a full second copy of this repository (166 MB as of writing) — and launch.json is this
# machine's dev-server config. None of it belongs in the repo, and a stray `git add .` would
# otherwise sweep a whole worktree in.
.claude/
